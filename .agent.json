{
  "default": "deepseek",
  "profiles": {
    "deepseek": {
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-chat",
      "api_key_env": "DEEPSEEK_API_KEY"
    },
    "deepseek-reasoner": {
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-reasoner",
      "api_key_env": "DEEPSEEK_API_KEY",
      "timeout": 300
    },
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "model": "gpt-4o-mini",
      "api_key_env": "OPENAI_API_KEY"
    },
    "local": {
      "base_url": "http://localhost:8000/v1",
      "model": "qwen-max",
      "api_key_env": null
    }
  }
}
